<?xml version="1.0"?>
<sdf version="1.6">
  <model name="wall">
    <static>true</static>

    <link name="wall_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="wall_visual">
        <geometry>
          <box>
            <size>0.2 10.0 6.096</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.65 0.65 1</ambient>
          <diffuse>0.65 0.65 0.65 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="wall_collision">
        <geometry>
          <box>
            <size>0.2 10.0 6.096</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
            <bullet>
              <friction>0.6</friction>
              <friction2>0.6</friction2>
            </bullet>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
