    <!-- model of end_effector -->

    <joint name='connect_joint' type='prismatic'>
      <pose relative_to='operator_1_Link'>0.515159 -0.008754 0.29747 2.0944 -0 -1.58779</pose>
      <parent>operator_1_Link</parent>
      <child>connect_Link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0</upper>
          <effort>100</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>300</spring_stiffness>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
      <sensor name="force_torque" type="force_torque">
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>ft_sensor_data</topic>
      </sensor>
    </joint>

