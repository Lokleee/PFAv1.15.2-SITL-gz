    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>operator_1_joint</joint_name>
      <!-- 显式指定话题名，与 ros2_bridge_config.yaml 中的 gz_topic_name 对齐 -->
      <topic>operator_1_joint_cmd_pos</topic>
      <!-- 初始目标角度（弧度），防止启动时关节乱动 -->
      <!-- <initial_position>-0.52359878</initial_position> -->
      <!-- <initial_position>1.0471975512</initial_position> -->
      <!-- PID 参数 -->
      <!-- 减振调参：增大 D 抑制超调，I 暂设 0 排除干扰 -->
      <p_gain>50</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>8</d_gain>
      <i_max>10</i_max>
      <i_min>-10</i_min>
      <!-- 输出力矩上下限（N·m），对应 SDF 中 effort: 100 -->
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
    <!-- <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <options>
          <include_fixed>true</include_fixed>
      </options>
    </plugin> -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>operator_1_joint_state</topic>
      <joint_name>operator_1_joint</joint_name>
    </plugin>
  </model>
</sdf>
